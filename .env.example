# Copy to .env and fill in. docker compose auto-loads this project-root file and
# interpolates the values into the backend service (see docker-compose.yml).
# Sign-in is ORCID-only: with no client id the API returns 503 for /auth/orcid/*.

# ── ORCID OAuth ─────────────────────────────────────────────────────────────
# Register a client at https://orcid.org/developer-tools (free for any ORCID
# member). Request scope "/authenticate" and set the client's Redirect URI to
# exactly the NDB_ORCID_REDIRECT_URI below.
#
# Production uses https://orcid.org; for throwaway test accounts point BASE at
# https://sandbox.orcid.org (sandbox iDs are SEPARATE accounts from real ones).
ORCID_BASE=https://orcid.org
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:5173/auth/orcid/callback

# Comma-separated ORCID iDs granted the `admin` role on first sign-in.
# Everyone else defaults to `contributor`. Example:
# ORCID_ADMIN_IDS=0000-0002-1825-0097
ORCID_ADMIN_IDS=

# Change in any shared/deployed environment (invalidates existing sessions).
NDB_JWT_SECRET=dev-secret-change-me

# ── DEV-ONLY sign-in ────────────────────────────────────────────────────────
# ORCID OAuth can't round-trip on localhost. Set NDB_DEV_LOGIN=true to enable
# a password-less "sign in as <demo user>" flow on the login page (mints tokens
# only for the seeded curator/reviewer/admin@tbia.test users). Leave false/unset
# in any shared or deployed environment — enabling it there is an auth bypass.
NDB_DEV_LOGIN=false

# ── Reverse proxy / TLS (production; docker-compose.prod.yml) ────────────────
# The `web` (Caddy) service reads these. If UNSET, compose defaults to
# SITE_ADDRESS=:80 with no TLS — Caddy then serves HTTP-only, which breaks
# origin TLS on :443 (Cloudflare "Full (strict)" shows 525). Behind a
# Cloudflare orange-cloud proxy, ACME is blocked, so use a Cloudflare Origin
# Certificate (mounted at /etc/caddy/certs) and set both of these. See DEPLOY.md.
#   SITE_ADDRESS=https://your-domain.example.org
#   CADDY_TLS=tls /etc/caddy/certs/cf-origin.pem /etc/caddy/certs/cf-origin.key
#
# Local/dev uses docker-compose.yml (Vite + FastAPI, no Caddy) — leave unset.
