# Served by the `web` container (frontend/Dockerfile.prod).
#
# SITE_ADDRESS = your domain (e.g. tbia.example.org) -> automatic Let's Encrypt
#   TLS, or ":80" for plain HTTP (testing / IP-only; logins go in cleartext).
#
# CADDY_TLS  = TLS source. Leave UNSET for automatic Let's Encrypt (direct /
#   "DNS only" deployments). Behind a Cloudflare proxy (orange cloud), ACME is
#   blocked, so use a Cloudflare Origin Certificate and set:
#     CADDY_TLS="tls /etc/caddy/certs/cf-origin.pem /etc/caddy/certs/cf-origin.key"
#   (and set Cloudflare SSL/TLS mode to "Full (strict)"). See DEPLOY.md.
{$SITE_ADDRESS} {
	{$CADDY_TLS:}
	root * /srv

	# API -> backend container. Same origin, so the SPA's relative /api works.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# SPA: serve the file if it exists, then the prerendered per-route copy
	# (dist/story/begonia/index.html — written by scripts/prerender.mjs so link
	# unfurlers and crawlers get real <title>/og tags without running JS), else
	# fall back to index.html for client-side routing.
	#
	# Caching, inside this block so the /api/* handler above keeps the headers
	# backend/app/cache.py sets: Vite content-hashes everything under /assets/,
	# so those can be held forever, while the HTML must be revalidated or a
	# redeploy stays invisible behind the CDN. The matchers are complementary
	# rather than general-then-specific, because two `header` directives naming
	# the same field would otherwise just overwrite one another.
	handle {
		@assets path /assets/*
		@notassets not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @notassets Cache-Control "public, max-age=0, must-revalidate"

		try_files {path} {path}/index.html /index.html
		file_server
	}
}
