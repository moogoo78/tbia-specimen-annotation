# Multi-stage production image: build the static SPA, then serve it from Caddy
# (which also reverse-proxies /api to the backend, giving same-origin so the
# frontend's relative `/api` calls work without CORS). Multi-arch: builds on
# arm64 (t4g) and x86 unchanged.
FROM node:20-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
# Vite inlines VITE_* at build time, so the GA measurement ID has to be a build
# arg (not a runtime env var). Empty -> analytics compiles out to a no-op.
ARG VITE_GA_MEASUREMENT_ID=""
ENV VITE_GA_MEASUREMENT_ID=$VITE_GA_MEASUREMENT_ID
# Deployed origin, e.g. https://example.org. Build-time for the same reason:
# scripts/prerender.mjs (run by `npm run build`) needs it for canonical, og:url
# and sitemap.xml. Empty -> those are skipped, never guessed.
ARG VITE_SITE_URL=""
ENV VITE_SITE_URL=$VITE_SITE_URL
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
