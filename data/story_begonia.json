        },
        {
          "seq": 3,
          "verbatim_date": "2013.10.10–16",
          "date_start": "2013-10-10",
          "date_end": "2013-10-16",
          "precision": "day",
          "narrative": "為進行「亞洲喀斯特石灰岩地區秋海棠屬植物之演化與生態研究」計劃，前往泰國西部石灰岩區域進行秋海棠屬植物考察採樣。彭老師研究團隊多年來對秋海棠屬植物親緣關係研究之經驗，顯示中越邊境喀斯特石灰岩地區秋海棠屬植物的多樣性起源和種化機制特別值得探討，曾多次前往中越邊境考察採樣。此行主要勘查泰國西部石灰岩地區秋海棠分布及物種多樣性，由助理黃建益偕行。承瑪希敦大學 (Mahidol University) 研究秋海棠的Dr. Phutthai協助安排與嚮導。",
          "party": [
            {
              "name": "黃建益"
            },
            {
              "name": "Thamarat Phutthai"
            }
          ]
        }
      ],
