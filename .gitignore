# --- Secrets / env (never commit) ---
.env
.env.*
!.env.example
*.env
dotenvbak
envbak
*.pem
*.key
secrets*

# --- Generated data dir (DBs, CSVs, spill tmp; all large/derived) ---
# Everything under data/ is generated or scp'd in at deploy time, except
# registry.json: that one is hand-curated source and lives in git.
/data/*
!/data/.gitkeep
!/data/registry.json
!/data/sampling_events.json
!/data/story_begonia.json
!/data/media_variants.json

# --- Raw data exports & API scratch dumps at repo root (large / not source) ---
/tbia_*.csv
/tbia_*.zip
/response_*.csv
/response_*.json
*.zip
# The downloaded TBIA export + its field docs (~2 GB), and TBIA API scratch dumps.
# The /tbia_*.csv|zip rules above only match at the repo root, so the unpack
# directories need their own entries.
/source/
/tmp-source/
/tmp/
/results/

# --- Intermediate dataset-selection working files (not needed to run/serve) ---
/dataset-selected13.json
/selected-13-dataset-ids.txt

# --- Agent / editor local state ---
.claude/
.DS_Store

# --- Python ---
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Node ---
frontend/node_modules/
frontend/dist/
# tsc -b incremental cache: regenerated by every typecheck/build, churns on
# every commit, and is worthless to anyone else.
frontend/tsconfig.tsbuildinfo
